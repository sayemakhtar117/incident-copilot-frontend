# Leave empty in local development: the Vite dev server proxies /api to http://localhost:8081.
# For a deployed UI, set it to your backend URL (no trailing slash), for example:
# VITE_API_BASE_URL=https://incident-copilot.onrender.com
VITE_API_BASE_URL=

# Optional Grafana Cloud Frontend Observability collector URL; Faro is disabled when empty.
# Configure the app's allowed origin as https://incidentpilot.in in Grafana.
VITE_FARO_URL=
